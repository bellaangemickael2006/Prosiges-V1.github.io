# ------------------------------------------------------------------
# Copiez ce fichier en « .env » et remplissez les valeurs.
# Le fichier .env ne doit JAMAIS être versionné dans Git.
# ------------------------------------------------------------------

# Clé secrète des sessions — générez-en une avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=remplacez-par-une-cle-aleatoire-longue

# Nom affiché dans l'application
NOM_CABINET=AK World

# Base de données
# En local : laissez vide (SQLite est utilisé automatiquement)
# En production : URL PostgreSQL fournie par l'hébergeur
DATABASE_URL=

# Cookies sécurisés : mettre true en production (HTTPS obligatoire)
COOKIE_SECURE=false

# Suivi des erreurs en production (facultatif)
# Créez un projet gratuit sur https://sentry.io puis collez son DSN ici.
# Laissez vide pour désactiver.
SENTRY_DSN=
ENVIRONNEMENT=developpement

# ---- Google Drive / Sheets (facultatif) ----
# Chemin du fichier de clé du compte de service
GOOGLE_CREDENTIALS_FILE=credentials.json
# ID du dossier Drive parent (visible dans l'URL du dossier)
GOOGLE_DRIVE_FOLDER_ID=
# ID du Google Sheet global (visible dans l'URL du document)
GOOGLE_SHEET_ID=
